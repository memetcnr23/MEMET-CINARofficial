# Required locally unless you use Vercel OIDC (automatic on Vercel deployments).
# The Vercel team must have a credit card on file for AI Gateway.
AI_GATEWAY_API_KEY=

# Optional. Gateway model used when Jev's confidence is below 0.95 (default: openai/gpt-6-luna-fast).
ROUTER_FALLBACK_MODEL=

# Optional email delivery. Use a verified Resend sender (e.g., no-reply@yourdomain.com).
RESEND_API_KEY=
RESEND_FROM=

# Receiving inboxes. ROUTE_TO_DEFAULT receives every destination unless a specific
# ROUTE_TO_<DESTINATION_ID> is set (IDs are listed in lib/recipients.ts), e.g.:
ROUTE_TO_DEFAULT=
# ROUTE_TO_BILLING_REFUNDS=billing@yourdomain.com
